{
  "name": "SquadTS",
  "version": "0.1.0",
  "repository": "https://github.com/Gractus/SquadTS.git",
  "author": "Gordon Beintmann <https://github.com/Gractus>",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "start": "node dist/index.js",
    "prepare": "husky",
    "lint": "eslint --fix . && prettier --write \"./**/*.js\"",
    "lint-staged": "lint-staged",
    "build-application": "tsc",
    "build-config": "tsc && node ./dist/build/build-config-file.js",
    "build-readme": "tsc && node ./dist/build/build-readme.js",
    "build-asset-data": "tsc && node ./dist/build/build-asset-data.js",
    "build-all": "tsc && node ./dist/build/build-config-file.js && node ./dist/build/build-readme.js"
  },
  "dependencies": {
    "basic-ftp": "^6.2.2",
    "discord.js": "^14.27.0",
    "re2": "^1.27.0",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/ssh2": "^1.15.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-promise": "^7.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "download"
    }
  }
}