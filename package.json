{
  "name": "SquadJS",
  "version": "4.1.0",
  "repository": "https://github.com/Team-Silver-Sphere/SquadJS.git",
  "author": "Thomas Smyth <https://github.com/Thomas-Smyth>",
  "license": "BSL-1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "prepare": "husky",
    "lint": "eslint --fix . && prettier --write \"./**/*.js\"",
    "lint-staged": "lint-staged",
    "build-config": "node ./build/build-config-file.js",
    "build-readme": "node ./build/build-readme.js",
    "build-all": "node ./build/build-config-file.js && node ./build/build-readme.js"
  },
  "type": "module",
  "dependencies": {
    "async": "^3.2.6",
    "axios": "^1.19.0",
    "basic-ftp": "^6.2.0",
    "chalk": "^6.0.0",
    "discord.js": "^14.27.0",
    "ftp-tail": "^2.1.1",
    "graphql-request": "^7.4.0",
    "moment": "^2.30.1",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.3",
    "sqlite3": "^6.0.1",
    "tail": "^2.2.6",
    "tinygradient": "^2.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-promise": "^7.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  }
}